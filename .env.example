# Firebase console → Project settings → Your apps → Web SDK configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set this when the web app uses reCAPTCHA v3 for Firebase App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# For local Vite development only. Register the generated browser debug token in Firebase App Check.
VITE_FIREBASE_APPCHECK_DEBUG=false
